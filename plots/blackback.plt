; blackback.plt - data plot with black background
;                 from JoAnn McGee
;
; define a new color palette
%define RGB  "($1/1000) ($2/1000) ($3/1000)"
%RGB      0     0     0 ; black         0
%RGB      0     0  1000 ; blue          1
%RGB      0  1000     0 ; green         2
%RGB      0   667   667 ; cyan          3
%RGB   1000     0     0 ; red           4
%RGB      0     0   333 ; midnight blue 5
%RGB    667   333     0 ; brown         6
%RGB    667   667   667 ; lt grey       7
%RGB    333   333   333 ; dk grey       8
%RGB    100   750  1000 ; lt blue       9
%RGB    333  1000   333 ; lt green      10
%RGB    333  1000  1000 ; lt cyan       11
%RGB   1000   333   333 ; lt red        12
%RGB   1000   333  1000 ; lt magenta    13
%RGB   1000  1000   333 ; yellow        14
%RGB   1000  1000  1000 ; white         15
%RGB   1000   400    50 ; orange        16
%RGB   1000    50    50 ; other red     17
%RGB      0   667     0 ; other green   18
%RGB      0     0   667 ; deep blue     19
%RGB    667     0     0 ; deep red      20
%RGB    750  1000   333 ; lt green      21
palette
;
BGCOL=0
ANNCOL=15 : AXCOL=15 : MSGCOL=15 : labcol=15
;
pltcol=15

wxlen=12 : wylen=10
header=no : openax=yes : corner=no : yhor=yes : sort=yes
ticdir=in : ticsiz=0.75

mhalign=left : msgsiz=-.16 ;1.1
-0.1,5.65 "A. 22.6 kHz"
3.4,5.65 "B. 11.3 kHz"
-0.1,2.4 "C. 8.0 kHz"
3.4,2.4 "D. 5.6 kHz"

