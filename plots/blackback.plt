msgangle=45
6.75, 3.3 "Control"
mslant=10
7.15, 3.3 "Tshr{hyt/hyt}"
mslant=0
msgangle=0


mvalign=half : msgsiz=1.3 : mhalign=center
3.2,-.8"Stimulus Level (dB SPL)"
